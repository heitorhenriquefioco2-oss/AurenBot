{
  "manifest_version": 3,
  "name": "Auren — Caçada v3.3.22",
  "version": "3.3.22",
  "description": "Escolha sua criatura, cuide do vigor do herói e economize poções durante as caçadas.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "notificacoes.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Auren — Caçada"
  },
  "content_scripts": [
    {
      "matches": [
        "https://auren-online.com/*",
        "https://www.auren-online.com/*"
      ],
      "js": [
        "avisos.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://auren-online.com/*",
        "https://www.auren-online.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
