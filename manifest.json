{
  "manifest_version": 3,
  "name": "Auren — Caçada v3.3.6",
  "version": "3.3.6",
  "description": "Painel de caçada com seleção de criatura, limites de vida e economia de poções.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Auren — Caçada",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://auren-online.com/*",
        "https://www.auren-online.com/*"
      ],
      "js": [
        "avisos.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://auren-online.com/*",
        "https://www.auren-online.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
