{
  "manifest_version": 3,
  "name": "Auren — Caçada v3.3.39",
  "version": "3.3.39",
  "description": "Caça, recupera o vigor e avisa quando o jogo precisa da sua resposta.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "minimum_chrome_version": "120",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "notificacoes.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Auren — Caçada"
  },
  "content_scripts": [
    {
      "matches": ["https://auren-online.com/*", "https://www.auren-online.com/*"],
      "js": ["pagina-segundo-plano.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://auren-online.com/*",
        "https://www.auren-online.com/*"
      ],
      "js": [
        "avisos.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://auren-online.com/*",
        "https://www.auren-online.com/*"
      ],
      "js": [
        "segundo-plano.js",
        "content.js",
        "boss.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
